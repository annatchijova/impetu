# ÍMPETU configuration. Copy to `.env` (which is gitignored) and adjust.
#
# Auth path: Vertex AI on Google Cloud (ADC via `gcloud auth application-default
# login`). No API key is stored here. This gives real quota and satisfies the
# hackathon's Google Cloud requirement. The AI Studio free tier (20 req/day) is
# not enough for development.

GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=vigia-497422
# Gemini 3.5 lives on the Vertex "global" endpoint, not a single region.
GOOGLE_CLOUD_LOCATION=global
MODEL=gemini-3.5-flash

# --- Security (see docs/RED-TEAM.md). All of these fail CLOSED when unset. ---
# Per-person Google tokens are preferred: someone with their own connected
# account needs no grant, because the side effect lands on THEIR account.
#   local dev  : python3 setup_gmail.py <user_id>  -> tokens/<user_id>.json
#   production : Secret Manager secret impetu-google-token-<user_id>
IMPETU_TOKEN_DIR=
IMPETU_TOKEN_SECRET_PREFIX=

# Fallback for anyone WITHOUT their own token: the single shared OAuth token
# belongs to exactly one person, and only this user_id may use it. Unset, and
# users without a personal token get no Google access at all.
IMPETU_OWNER_USER_ID=

# The agent routes carry user_id in the URL and have no auth of their own.
# Set a token (sent as X-Impetu-Token) to keep them private...
IMPETU_ACCESS_TOKEN=
# ...or run them publicly pinned to the demo profile, which cannot reach Google.
IMPETU_PUBLIC_DEMO=

# Required by /nudge. Authenticates the scheduler; it does NOT authorize
# operating on a named person - that is IMPETU_OWNER_USER_ID's job.
NUDGE_TOKEN=
